FoamFile { version 2.0; format ascii; class dictionary; object fvSolution; }
solvers {
 p_rgh { solver PCG; preconditioner DIC; tolerance 1e-13; relTol 0; }
 "(U|h|e|w|k|epsilon)" { solver PBiCGStab; preconditioner DILU; tolerance 1e-13; relTol 0; }
}
SIMPLE { nNonOrthogonalCorrectors 0; pRefCell 0; pRefValue 101325;
 residualControl { p_rgh 1e-11; U 1e-11; h 1e-11; w 1e-11; "(k|epsilon)" 1e-10; Tg 1e-10; }
}
relaxationFactors { Tg 0.5; fields { rho 1; p_rgh 0.7; } equations { U 0.7; h 1; w 1; k 0.7; epsilon 0.7; } }
